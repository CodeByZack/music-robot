    {
      "type": "text",
      "id": "cfg_code_t",
      "x": 96,
      "y": 4024,
      "width": 1148,
      "height": 612,
      "text": "{\n  \"server\":   { \"host\": \"0.0.0.0\", \"port\": 8080,\n                \"jwt_secret\": \"<env:MR_JWT_SECRET>\",\n                \"token_expiry_hours\": 24 },\n  \"storage\":  { \"type\": \"local\",\n                \"library_roots\": [\"/music/华语\", \"/music/古典\"] },\n  \"database\": { \"path\": \"~/.local/share/music-robot/music.db\" },\n  \"audio\":    { \"transcode\": true,\n                \"cache_dir\": \"~/.cache/music-robot/transcode\",\n                \"cache_expiry_days\": 30, \"ffmpeg_path\": \"ffmpeg\" },\n  \"watcher\":  { \"enabled\": true, \"debounce_ms\": 500,\n                \"self_write_suppress_ms\": 5000 },\n  \"scrape\":   { \"concurrency\": 3, \"batch_size\": 100,\n                \"task_timeout_sec\": 30, \"max_retry\": 2,\n                \"request_delay_ms\": 500,\n                \"rate_limit_cooldown_sec\": 60,\n                \"per_plugin_max\": { \"netease\": 1, \"qqmusic\": 1,\n                                    \"musicbrainz\": 2 } },\n  \"plugins\":  { \"sandbox\": \"auto\",\n                \"plugin_user\": \"music-plugin\",\n                \"limits\": { \"memory_mb\": 512, \"cpu_sec\": 60,\n                            \"procs\": 64, \"file_mb\": 100 } },\n  \"log\":      { \"level\": \"info\",\n                \"dir\": \"~/.local/share/music-robot/logs\" }\n}",
      "originalText": "{\n  \"server\":   { \"host\": \"0.0.0.0\", \"port\": 8080,\n                \"jwt_secret\": \"<env:MR_JWT_SECRET>\",\n                \"token_expiry_hours\": 24 },\n  \"storage\":  { \"type\": \"local\",\n                \"library_roots\": [\"/music/华语\", \"/music/古典\"] },\n  \"database\": { \"path\": \"~/.local/share/music-robot/music.db\" },\n  \"audio\":    { \"transcode\": true,\n                \"cache_dir\": \"~/.cache/music-robot/transcode\",\n                \"cache_expiry_days\": 30, \"ffmpeg_path\": \"ffmpeg\" },\n  \"watcher\":  { \"enabled\": true, \"debounce_ms\": 500,\n                \"self_write_suppress_ms\": 5000 },\n  \"scrape\":   { \"concurrency\": 3, \"batch_size\": 100,\n                \"task_timeout_sec\": 30, \"max_retry\": 2,\n                \"request_delay_ms\": 500,\n                \"rate_limit_cooldown_sec\": 60,\n                \"per_plugin_max\": { \"netease\": 1, \"qqmusic\": 1,\n                                    \"musicbrainz\": 2 } },\n  \"plugins\":  { \"sandbox\": \"auto\",\n                \"plugin_user\": \"music-plugin\",\n                \"limits\": { \"memory_mb\": 512, \"cpu_sec\": 60,\n                            \"procs\": 64, \"file_mb\": 100 } },\n  \"log\":      { \"level\": \"info\",\n                \"dir\": \"~/.local/share/music-robot/logs\" }\n}",

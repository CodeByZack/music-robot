      "link": null,
      "locked": false
    },
    {
      "type": "text",
      "id": "sec_l2",
      "x": 5460,
      "y": 3656,
      "width": 280,
      "height": 18,
      "text": "进程外策略（主服务负责）",
      "originalText": "进程外策略（主服务负责）",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",

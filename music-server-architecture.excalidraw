    {
      "type": "rectangle",
      "id": "sec_threat",
      "x": 3720,
      "y": 3684,
      "width": 1700,
      "height": 200,
      "strokeColor": "#dc2626",
      "backgroundColor": "#fef2f2",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 2500007,
      "version": 1,
      "versionNonce": 2500008,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": [
        {
          "id": "sec_threat_t",

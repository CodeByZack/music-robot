    {
      "type": "text",
      "id": "sec_ok",
      "x": 5476,
      "y": 3958,
      "width": 830,
      "height": 376,
      "text": "防得住\n────────────────────────────────\n吃光内存            ✅ RLIMIT_AS\n死循环占 CPU        ✅ RLIMIT_CPU\nfork 炸弹           ✅ RLIMIT_NPROC\n单文件写满磁盘      ✅ RLIMIT_FSIZE\n偷读曲库 / 私人文件 ✅ 文件权限\n往系统目录写        ✅ 非 root 用户\n提权                ✅ no_new_privs\n孤儿进程            ✅ setsid + killpg + PDEATHSIG",
      "originalText": "防得住\n────────────────────────────────\n吃光内存            ✅ RLIMIT_AS\n死循环占 CPU        ✅ RLIMIT_CPU\nfork 炸弹           ✅ RLIMIT_NPROC\n单文件写满磁盘      ✅ RLIMIT_FSIZE\n偷读曲库 / 私人文件 ✅ 文件权限\n往系统目录写        ✅ 非 root 用户\n提权                ✅ no_new_privs\n孤儿进程            ✅ setsid + killpg + PDEATHSIG",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "strokeColor": "#065f46",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 2500027,
      "version": 1,
      "versionNonce": 2500028,
      "isDeleted": false,

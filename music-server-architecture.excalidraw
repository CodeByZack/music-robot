      "id": "pbx_title",
      "x": 1900,
      "y": 3220,
      "width": 520,
      "height": 34,
      "text": "播放消费 · API 全清单与数据流",
      "originalText": "播放消费 · API 全清单与数据流",
      "fontSize": 26,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",

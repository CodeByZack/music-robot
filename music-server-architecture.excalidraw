      "locked": false
    },
    {
      "type": "text",
      "id": "sec_l3",
      "x": 3720,
      "y": 3916,
      "width": 460,
      "height": 18,
      "text": "进程内策略：执行顺序（fork 之后 · exec 之前，纯 libc）",
      "originalText": "进程内策略：执行顺序（fork 之后 · exec 之前，纯 libc）",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "strokeColor": "#991b1b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 2500017,
      "version": 1,
      "versionNonce": 2500018,
      "isDeleted": false,

target/

# 本机专属的环境文件，不入库 —— 模板是仓库里的 env.example。
#   env.sh    : 当前这台 NAS 专属（写死了工具链与二进制的绝对路径），对别人没用
#   env.local : 你从 env.example 复制出来改的那份
env.sh
env.local
.env

# 测试音频样本不入库（64M）——真拷贝放本地，重建方式见 HANDOFF.md §8.3
/fixtures

# 运行时插件目录：用户放自己的单文件脚本，不进仓库。
# registry 只扫这一层、**不递归**，所以 `*` 与 `*/*` 的放行都要写。
/plugins/*
!/plugins/examples/
!/plugins/musicbrainz.js

# 仓库自带的示例插件（假数据）：既是插件作者照抄的模板，也是 tests/plugin_e2e.rs
# 和 scripts/api_test.mjs 的测试夹具。**放在 examples/ 子目录里**，别挪到 plugins/ 顶层 ——
# 插件按文件名升序尝试、命中即停，而 example.js 永远返回 confidence 0.95，
# 一旦和 musicbrainz.js 同层，那个真插件就永远不会被执行。
!/plugins/examples/*

# ── 前端（apps/ packages/）────────────────────────────────
node_modules/
dist/
.expo/
web-build/
*.tsbuildinfo
.env.local

# 前端构建产物
apps/*/dist/
